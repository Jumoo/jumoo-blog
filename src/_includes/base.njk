<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <!-- Applies a stored light/dark choice before first paint, shared with
       jumoo.co.uk's footer toggle (same "jumoo-theme" key, though each site
       has its own localStorage). No stored value means light - the OS/browser
       preference is deliberately ignored, as on the main site. -->
  <script>
    (function () {
      try {
        var stored = localStorage.getItem("jumoo-theme");
        if (stored === "light" || stored === "dark") {
          document.documentElement.setAttribute("data-theme", stored);
        }
      } catch (e) {}
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="icon" href="{{ '/assets/img/brand/jumoo-badge.svg' | url }}" type="image/svg+xml">
  <link rel="icon" href="{{ '/assets/img/brand/jumoo-avatar-32.png' | url }}" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="{{ '/assets/img/brand/jumoo-avatar-256.png' | url }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url | url }}">

  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url | url }}">
  <meta property="og:image" content="{{ site.url }}{{ (image or site.image) | url }}">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.name }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ site.url }}{{ (image or site.image) | url }}">

  <link rel="preload" href="{{ '/assets/fonts/barlow-400-latin.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/style.css' | url }}">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="wrap site-header__inner">
      <div class="brand">
        <a class="wordmark" href="{{ site.home }}/">{% include "partials/wordmark.njk" %}</a>
        <a class="brand__section" href="{{ '/' | url }}">Blog</a>
      </div>

      <input type="checkbox" id="nav-toggle" class="nav-toggle">
      <label for="nav-toggle" class="nav-toggle__label" aria-hidden="true">
        <span class="nav-toggle__bars"></span>
        <span class="visually-hidden">Menu</span>
      </label>

      <nav class="site-nav" aria-label="Main">
        <ul>
          {% for item in site.nav %}
            <li><a href="{{ item.url | url }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.name }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    </div>
  </header>

  <div class="wrap layout">
    <main id="main">
      {{ content | safe }}
    </main>
    <aside class="sidebar" aria-label="Blog">
      {% include "sidebar.njk" %}
    </aside>
  </div>

  <footer class="site-footer">
    <div class="wrap">
      <div class="site-footer__cols">
        <div>
          <a class="wordmark wordmark--footer" href="{{ site.home }}/">{% include "partials/wordmark.njk" %}</a>
          <p class="muted">{{ site.tagline }}</p>
          <p class="muted"><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        </div>

        <div>
          <h2>Products</h2>
          <ul class="plain">
            <li><a href="{{ site.home }}/usync/">uSync</a></li>
            <li><a href="{{ site.home }}/usync/complete/">uSync.Complete</a></li>
            <li><a href="{{ site.home }}/translate/">Translation Manager</a></li>
            <li><a href="{{ site.releases }}/">Other Umbraco packages</a></li>
          </ul>
        </div>

        <div>
          <h2>Elsewhere</h2>
          <ul class="plain">
            <li><a href="{{ site.home }}/">jumoo.co.uk</a></li>
            <li><a href="{{ site.docs }}/">Documentation</a></li>
            <li><a href="{{ site.releases }}/">Release notes</a></li>
            <li><a href="https://github.com/Jumoo">GitHub</a></li>
          </ul>
        </div>

        <div>
          <h2>Company</h2>
          <ul class="plain">
            <li><a href="{{ site.home }}/about/">About us</a></li>
            <li><a href="{{ site.home }}/contact/">Contact us</a></li>
            <li><a href="{{ site.home }}/privacy/">Privacy policy</a></li>
            <li><a href="{{ site.home }}/terms/">Terms and conditions</a></li>
          </ul>
        </div>
      </div>

      <div class="site-footer__legal">
        <p class="muted">
          &copy; {{ "" | currentYear }} Jumoo Ltd. Umbraco is a trademark of Umbraco A/S.
        </p>

        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to dark theme">
          <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <circle cx="10" cy="10" r="3.6"/>
            <path d="M10 1.6v2.3M10 16.1v2.3M3.9 3.9l1.6 1.6M14.5 14.5l1.6 1.6M1.6 10h2.3M16.1 10h2.3M3.9 16.1l1.6-1.6M14.5 5.5l1.6-1.6"/>
          </svg>
          <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 12.2A7.2 7.2 0 0 1 7.8 3a7.2 7.2 0 1 0 9.2 9.2Z"/>
          </svg>
        </button>
      </div>
    </div>
  </footer>

  <script>
    (function () {
      var STORAGE_KEY = "jumoo-theme";
      var btn = document.getElementById("theme-toggle");
      if (!btn) return;

      function currentTheme() {
        var attr = document.documentElement.getAttribute("data-theme");
        return attr === "dark" ? "dark" : "light";
      }

      function updateLabel() {
        var next = currentTheme() === "dark" ? "light" : "dark";
        btn.setAttribute("aria-label", "Switch to " + next + " theme");
      }

      updateLabel();

      btn.addEventListener("click", function () {
        var next = currentTheme() === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        try {
          localStorage.setItem(STORAGE_KEY, next);
        } catch (e) {}
        updateLabel();
      });
    })();
  </script>
</body>
</html>
