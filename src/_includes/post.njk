---
layout: base.njk
---
<article class="post">
  <header class="post-head">
    <h1>{{ title }}</h1>
    <p class="post-meta">
      <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
    </p>
    {% if tags.length %}
    <ul class="tag-list">
      {% for tag in tags %}
      <li><a class="tag" href="{{ ('/tags/' + (tag | tagSlug) + '/') | url }}">{{ tag }}</a></li>
      {% endfor %}
    </ul>
    {% endif %}
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
</article>
